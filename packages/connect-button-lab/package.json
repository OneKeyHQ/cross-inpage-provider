{
  "name": "@onekeyfe/connect-button-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Electron dashboard and E2E harness for connectButtonHack",
  "main": "src/main.cjs",
  "scripts": {
    "prebuild": "node scripts/ensure-dependencies.mjs",
    "build": "npm run build:catalog && npm run build:hack",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:hack": "node scripts/build-hack-bundle.mjs",
    "build:desktop-preload": "node scripts/build-desktop-preload.mjs",
    "start": "npm run build && electron .",
    "dashboard": "npm run start",
    "test": "npm run build && electron . --smoke-test",
    "test:site": "npm run build && electron . --run-site",
    "test:all": "npm run build && electron . --run-all",
    "test:unit": "node --test tests/*.test.mjs",
    "registry:sync": "node src/cli/sync-registry.mjs",
    "registry:validate": "node src/cli/validate-registry.mjs",
    "registry:claim": "node src/cli/claim-batch.mjs",
    "registry:update": "node src/cli/update-protocol.mjs",
    "registry:custom-injected": "node src/cli/custom-injected-registry.mjs",
    "generate:adapters": "node src/cli/generate-adapters.mjs",
    "protocol": "node src/cli/run-protocol.mjs",
    "batch": "node src/cli/run-batch.mjs",
    "discover:dapp": "node src/cli/discover-dapp.mjs",
    "inspect:wallet": "node src/cli/inspect-wallet-ui.mjs",
    "synthesize:selector": "node src/cli/synthesize-selector.mjs",
    "generate:adapter": "node src/cli/generate-adapter.mjs",
    "generate:case": "node src/cli/generate-case.mjs",
    "diagnose": "node src/cli/diagnose-failure.mjs",
    "work-packet": "node src/cli/make-work-packet.mjs"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "electron": "39.8.9",
    "esbuild": "^0.25.12"
  }
}
